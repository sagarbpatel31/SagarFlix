generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  jobApps       JobApplication[]
  blogDrafts    BlogDraft[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model JobApplication {
  id          String   @id @default(cuid())
  slug        String   @unique
  company     String
  careerUrl   String
  roleKeywords String
  status      JobStatus @default(Saved)
  priority    JobPriority @default(Medium)
  notes       String   @default("")
  tags        String
  location    String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([slug])
}

enum JobStatus {
  Saved
  Applied
  Interviewing
  Rejected
  Follow_up
}

enum JobPriority {
  High
  Medium
  Low
}

model BlogDraft {
  id          String     @id @default(cuid())
  topic       String
  tone        BlogTone
  format      BlogFormat
  title       String
  summary     String
  fullContent String
  tags        String
  socialPost  String
  pinned      Boolean    @default(false)
  archived    Boolean    @default(false)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

enum BlogTone {
  Technical
  Reflective
  Direct
  Founder
}

enum BlogFormat {
  Blog
  LinkedIn_Post
  X_Thread
}